# ===== Aplikasi =====
APP_URL=https://domain-aplikasi-anda.vercel.app
PORT=3000
NODE_ENV=development

# ===== Keamanan (WAJIB di production) =====
# Kunci penanda tangan token login. String acak panjang, jangan dibagikan.
AUTH_SECRET=ganti-dengan-string-acak-panjang
# Login super admin: Kode RT "SUPERADMIN" + password ini
SUPERADMIN_PASSWORD=ganti-dengan-password-kuat

# ===== Google Sheets (Apps Script Web App) =====
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
# Harus SAMA dengan API_SECRET di google-apps-script/main.js
GAS_SECRET=ganti-dengan-string-acak

# ===== WhatsApp Gateway (folder whatsapp-gateway) =====
VPS_WHATSAPP_URL=http://IP-VPS:3001
# Harus SAMA dengan API_KEY di .env gateway
VPS_API_KEY=ganti-dengan-string-acak
# Harus SAMA dengan WEBHOOK_SECRET di .env gateway
WEBHOOK_SECRET=ganti-dengan-string-acak-lain
# Opsional: ID sesi WA tetap (default dari hostname)
WA_SESSION_ID=

# ===== Kop surat pengantar (PDF) =====
KOP_KELURAHAN=Sukamaju
KOP_KECAMATAN=Cibeunying
KOP_KOTA=Bandung
# RW default untuk warga yang mendaftar sendiri
DEFAULT_RW=05

# ===== Lainnya =====
GEMINI_API_KEY=
SUPABASE_DB_URL=
